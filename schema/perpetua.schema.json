{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esoxconsult/terra-perpetua/blob/main/schema/perpetua.schema.json",
  "title": "Terra Perpetua dataset",
  "description": "Sites where radioactive (and selected other high-hazard) waste is stored, disposed of or left behind. Schema version 2.",
  "type": "object",
  "required": ["schema_version", "license", "attribution", "sites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "generated": { "type": "string", "format": "date" },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/site" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "site": {
      "type": "object",
      "required": [
        "id", "name", "country", "country_code",
        "latitude", "longitude", "coord_precision",
        "facility_type", "status", "status_note", "status_as_of",
        "waste_types", "operator", "sources", "last_updated"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identifier: ISO country code (XZ = international waters) and three digits. Never reused.",
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{3}$"
        },
        "name": { "type": "string", "minLength": 2 },
        "country": { "type": "string", "minLength": 2 },
        "country_code": {
          "description": "ISO 3166-1 alpha-2; XZ for international waters.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "coord_precision": {
          "description": "facility: within about 1 km; locality: nearest town or general area, within about 10 km; region: approximate only.",
          "enum": ["facility", "locality", "region"]
        },
        "facility_type": {
          "enum": [
            "deep_geological",
            "near_surface",
            "interim_storage",
            "at_reactor_storage",
            "reprocessing_storage",
            "military_production",
            "research_lab",
            "chemical_underground",
            "accident_site",
            "test_site",
            "sea_dumping",
            "sunken_vessel",
            "uranium_legacy",
            "legacy_site"
          ]
        },
        "status": {
          "enum": [
            "operating",
            "commissioning",
            "under_construction",
            "planned",
            "dormant",
            "closed",
            "decommissioning",
            "cancelled",
            "remediation",
            "abandoned"
          ]
        },
        "status_note": { "type": "string" },
        "status_as_of": { "$ref": "#/$defs/date" },
        "waste_types": {
          "description": "Waste present at the site. Empty only for sites that hold no waste: research laboratories and exploration mines, and closed, cancelled, planned or dormant sites where no waste is known to remain or none has arrived yet.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "very-low-level",
              "low-level",
              "intermediate-level",
              "high-level",
              "spent-fuel",
              "transuranic",
              "norm",
              "chemical"
            ]
          }
        },
        "operator": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "title", "accessed"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "pattern": "^https?://" },
              "title": { "type": "string", "minLength": 1 },
              "accessed": { "$ref": "#/$defs/date" }
            }
          }
        },
        "notes": {
          "description": "Optional public remarks on data quality, open questions or conflicting sources.",
          "type": "string"
        },
        "last_updated": { "$ref": "#/$defs/date" }
      }
    }
  }
}
